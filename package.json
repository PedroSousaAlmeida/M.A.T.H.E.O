{
  "name": "matheo-nfse-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:e2e": "E2E_DATABASE_URL=${E2E_DATABASE_URL:-$DATABASE_URL} bun test test/app.e2e.spec.ts",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "postinstall": "bunx --bun prisma generate || true",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/throttler": "^6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7",
    "@xmldom/xmldom": "^0.9.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.12",
    "multer": "^2.3.0",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-crypto": "^6.1.2",
    "xpath": "^0.0.34",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "bun-types": "^1.4.2",
    "prisma": "^7",
    "supertest": "^7.2.2",
    "typescript": "^5"
  }
}
