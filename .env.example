PORT=3000
DATABASE_URL=postgresql://matheo:matheo@localhost:5432/matheo
# Logto (docker-compose exposes it on 3001; admin console on 3002)
LOGTO_ENDPOINT=http://localhost:3001
# Only needed when the API runs in a container (e.g. the `api` service in docker-compose.yml):
# LOGTO_ENDPOINT stays the host-facing URL so it matches the `iss` claim in issued tokens, while
# LOGTO_JWKS_URL points the API at Logto's in-network address to fetch signing keys.
# LOGTO_JWKS_URL=http://logto:3001/oidc/jwks
LOGTO_API_RESOURCE=https://api.matheo.local
# 32 random bytes as hex — generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_ENCRYPTION_KEY=
# fake | producao-restrita | producao
NFSE_ENV=fake
# Only required when NFSE_ENV != fake. Confirm both against https://www.nfse.gov.br/swagger/contribuintesissqn/
NFSE_SEFIN_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
NFSE_ADN_URL=https://adn.producaorestrita.nfse.gov.br/contribuintes

# Health endpoint metadata (all optional)
# NODE_ENV=development            # development | test | production
# APP_STAGE=alpha                 # alpha | beta | rc | stable — default: alpha while version is 0.x, stable from 1.0.0
# GIT_COMMIT=                     # injected at build time (Dockerfile ARG); shown in GET /health

# Logging
# LOG_LEVEL=info     # fatal | error | warn | info | debug | trace
# LOG_PRETTY=true    # human-readable output; default true only when NODE_ENV=development (JSON otherwise).
                      # Containers run with NODE_ENV=production and log JSON; set LOG_PRETTY=true to override.

# CORS — origens permitidas para o frontend (separadas por vírgula)
# CORS_ORIGINS=http://localhost:5173
