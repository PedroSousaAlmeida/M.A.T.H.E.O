{
  "info": {
    "name": "MATHEO NFS-e API",
    "version": "0.3.2",
    "description": "Backend emissor de NFS-e para MEI. Todas as rotas ficam sob {{baseUrl}} (= http://localhost:3000/api/v0). Exceto /health, todas exigem access token do Logto. A collection ja vem com OAuth 2.0 (Authorization Code + PKCE) apontando para o Logto: preencha logtoClientId/logtoClientSecret no environment, abra Authorization na collection e clique em 'Get New Access Token'. O parametro resource={{apiResource}} e obrigatorio para o Logto emitir um JWT com aud correto (sem ele o token e opaco e a API responde 401). A versao desta collection (info.version) acompanha a versao do package.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{logtoEndpoint}}/oidc/auth",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{logtoEndpoint}}/oidc/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{logtoClientId}}",
        "type": "string"
      },
      {
        "key": "clientSecret",
        "value": "{{logtoClientSecret}}",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "https://oauth.pstmn.io/v1/callback",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid profile offline_access",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "useBrowser",
        "value": false,
        "type": "boolean"
      },
      {
        "key": "tokenName",
        "value": "logto-access-token",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "authRequestParams",
        "value": [
          {
            "key": "resource",
            "value": "{{apiResource}}",
            "enabled": true,
            "sendIn": "queryParams"
          }
        ],
        "type": "any"
      },
      {
        "key": "tokenRequestParams",
        "value": [
          {
            "key": "resource",
            "value": "{{apiResource}}",
            "enabled": true,
            "sendIn": "body"
          }
        ],
        "type": "any"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v0"
    },
    {
      "key": "logtoEndpoint",
      "value": "http://localhost:3001"
    },
    {
      "key": "apiResource",
      "value": "https://api.matheo.local"
    },
    {
      "key": "logtoClientId",
      "value": ""
    },
    {
      "key": "logtoClientSecret",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Publico. 200 com versao/stage/apiVersion/ambiente/runtime/uptime e check de banco; 503 (status degraded) se o banco falhar."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "POST /companies — criar empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"11222333000181\",\n  \"razaoSocial\": \"Minha MEI LTDA\",\n  \"inscricaoMunicipal\": \"123456\",\n  \"codigoMunicipio\": \"3550308\",\n  \"email\": \"contato@exemplo.com\",\n  \"telefone\": \"11999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /companies/me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/companies/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PATCH /companies/me — atualizar dados",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razaoSocial\": \"Minha MEI Atualizada LTDA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PUT /companies/me/certificate — upload .pfx",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Certificado A1 (.pfx, max 10 KB)"
                },
                {
                  "key": "password",
                  "type": "text",
                  "value": "senha-do-certificado"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/companies/me/certificate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "me",
                "certificate"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "POST /customers — criar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('customerId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"11444777000161\",\n  \"nome\": \"Empresa Cliente\",\n  \"email\": \"fin@cliente.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /customers — listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?search=&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "empresa",
                  "disabled": true,
                  "description": "filtra por nome (contém) ou início do documento"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /customers/:id — detalhe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PATCH /customers/:id — atualizar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Empresa Cliente Ltda\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "POST /invoices — emitir NFS-e",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('invoiceId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tomadorDocumento\": \"12345678909\",\n  \"tomadorNome\": \"Cliente Exemplo\",\n  \"tomadorEmail\": \"cliente@exemplo.com\",\n  \"descricao\": \"Consultoria em tecnologia da informacao\",\n  \"valor\": 150.00,\n  \"codigoTributacao\": \"01.01.01\",\n  \"saveCustomer\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /invoices — emitir por customerId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('invoiceId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"descricao\": \"Consultoria\",\n  \"valor\": 150.00,\n  \"codigoTributacao\": \"01.01.01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /invoices — listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "ISSUED",
                  "disabled": true,
                  "description": "PENDING | ISSUED | REJECTED | CANCELLED"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id — detalhe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id/xml — XML da NFS-e",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/xml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "xml"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id/pdf — DANFSe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "pdf"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /invoices/:id/cancel — cancelar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Erro de digitacao no valor do servico\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "cancel"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "GET /alerts — avisos da empresa",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ]
            },
            "description": "Avisos calculados sobre a empresa logada: certificado ausente/vencido/a vencer, trial vencido/a vencer, notas PENDING paradas ha mais de 10 min. Resposta { alerts: [{ code, severity, message, data }] }, ordenada critical > warning > info. Liberado com trial vencido."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "GET /audit-logs — extrato de acoes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/audit-logs?action=&from=&to=&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit-logs"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "invoice.emitted",
                  "disabled": true,
                  "description": "filtra por acao exata, ex.: company.created, certificate.uploaded, customer.created, invoice.emitted, invoice.cancelled, trial.blocked"
                },
                {
                  "key": "from",
                  "value": "2026-01-01T00:00:00.000Z",
                  "disabled": true,
                  "description": "occurredAt >= from (ISO 8601)"
                },
                {
                  "key": "to",
                  "value": "2026-12-31T23:59:59.000Z",
                  "disabled": true,
                  "description": "occurredAt <= to (ISO 8601)"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Extrato de acoes (auditoria) da empresa logada, paginado, mais recentes primeiro. Cada item: { id, occurredAt, action, entityType, entityId, outcome, statusCode, metadata, requestId } (sem ip/userAgent, que ficam so no banco). Liberado com trial vencido."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "DELETE /customers/:id — remover",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
