{
  "info": {
    "name": "MATHEO NFS-e API",
    "version": "0.1.0",
    "description": "Backend emissor de NFS-e para MEI. Todas as rotas ficam sob {{baseUrl}} (= http://localhost:3000/api/v0). Exceto /health, todas exigem Bearer token do Logto na variavel {{token}}. A versao desta collection (info.version) acompanha a versao do package.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v0" },
    { "key": "token", "value": "" },
    { "key": "invoiceId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "POST /companies — criar empresa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"12345678000199\",\n  \"razaoSocial\": \"Minha MEI LTDA\",\n  \"inscricaoMunicipal\": \"123456\",\n  \"codigoMunicipio\": \"3550308\",\n  \"email\": \"contato@exemplo.com\",\n  \"telefone\": \"11999999999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/companies", "host": ["{{baseUrl}}"], "path": ["companies"] }
          },
          "response": []
        },
        {
          "name": "GET /companies/me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/companies/me", "host": ["{{baseUrl}}"], "path": ["companies", "me"] }
          },
          "response": []
        },
        {
          "name": "PATCH /companies/me — atualizar dados",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razaoSocial\": \"Minha MEI Atualizada LTDA\"\n}" },
            "url": { "raw": "{{baseUrl}}/companies/me", "host": ["{{baseUrl}}"], "path": ["companies", "me"] }
          },
          "response": []
        },
        {
          "name": "PUT /companies/me/certificate — upload .pfx",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "", "description": "Certificado A1 (.pfx, max 10 KB)" },
                { "key": "password", "type": "text", "value": "senha-do-certificado" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/companies/me/certificate", "host": ["{{baseUrl}}"], "path": ["companies", "me", "certificate"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "POST /invoices — emitir NFS-e",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('invoiceId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tomadorDocumento\": \"12345678909\",\n  \"tomadorNome\": \"Cliente Exemplo\",\n  \"tomadorEmail\": \"cliente@exemplo.com\",\n  \"descricao\": \"Consultoria em tecnologia da informacao\",\n  \"valor\": 150.00,\n  \"codigoTributacao\": \"01.01.01\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          },
          "response": []
        },
        {
          "name": "GET /invoices — listar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "ISSUED", "disabled": true, "description": "PENDING | ISSUED | REJECTED | CANCELLED" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id — detalhe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}"] }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id/xml — XML da NFS-e",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}/xml", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}", "xml"] }
          },
          "response": []
        },
        {
          "name": "GET /invoices/:id/pdf — DANFSe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pdf", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}", "pdf"] }
          },
          "response": []
        },
        {
          "name": "POST /invoices/:id/cancel — cancelar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"motivo\": \"Erro de digitacao no valor do servico\"\n}" },
            "url": { "raw": "{{baseUrl}}/invoices/{{invoiceId}}/cancel", "host": ["{{baseUrl}}"], "path": ["invoices", "{{invoiceId}}", "cancel"] }
          },
          "response": []
        }
      ]
    }
  ]
}
